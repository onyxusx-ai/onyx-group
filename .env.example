# Локальная проверка scripts/local-preview.mjs
ONYX_PREVIEW_PORT=8787
ONYX_PREVIEW_DB=.dev/preview.sqlite
ONYX_PREVIEW_SETUP_TOKEN=
ONYX_PREVIEW_ADMIN_TOKEN=

# ИИ-помощник. Ключ не добавляйте в Git.
OPENAI_API_KEY=
OPENAI_MODEL=

# Telegram администратора. Все значения задаются как секреты production.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
# Формат: telegram_user_id:email_сотрудника,telegram_user_id:email_сотрудника
TELEGRAM_ADMIN_BINDINGS=
# Оставьте false, пока не проверена ручная отправка одного платежа.
TELEGRAM_LIVE_APPROVED=false

# В production эти значения задаются через `wrangler secret put`, а не .env.
# SETUP_TOKEN=
# ADMIN_TOKEN=
